{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1440px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"palette": [
				{ "slug": "primary",      "color": "#7A5719", "name": "Bronze (Text-Safe Primary)" },
				{ "slug": "primary-dark", "color": "#5E4313", "name": "Bronze (Dark)" },
				{ "slug": "ink",          "color": "#0A090C", "name": "Neutral Black" },
				{ "slug": "gold",         "color": "#B6984E", "name": "Gold (Buttons, Rules)" },
				{ "slug": "copper",       "color": "#A16D29", "name": "Copper (Accent)" },
				{ "slug": "light-gold",   "color": "#E3D5B4", "name": "Light Gold" },
				{ "slug": "champagne",    "color": "#E1DCD2", "name": "Champagne (Alt Band)" },
				{ "slug": "background",   "color": "#F8F6F1", "name": "Ivory (Page)" },
				{ "slug": "surface",      "color": "#FFFDF9", "name": "Surface" },
				{ "slug": "text-muted",   "color": "#5C554B", "name": "Muted Text" },
				{ "slug": "border",       "color": "#DDD3C1", "name": "Border" }
			]
		},
		"typography": {
			"customFontSize": false,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading (Micaroline / Poiret One)",
					"fontFamily": "'Micaroline', 'Poiret One', 'Josefin Sans', 'Century Gothic', sans-serif"
				},
				{
					"slug": "body",
					"name": "Body (Avant Garde / Questrial)",
					"fontFamily": "'ITC Avant Garde Gothic Pro', 'ITC Avant Garde Gothic', 'Questrial', 'Century Gothic', 'Avenir Next', system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small",   "name": "Small",         "size": "clamp(0.875rem, 1.8vw, 1rem)" },
				{ "slug": "medium",  "name": "Base",          "size": "clamp(1rem, 2vw, 1.125rem)" },
				{ "slug": "large",   "name": "Large",         "size": "clamp(1.125rem, 2.2vw, 1.375rem)" },
				{ "slug": "x-large", "name": "Heading",       "size": "clamp(1.75rem, 3.5vw, 2.5rem)" },
				{ "slug": "xx-large","name": "Display",       "size": "clamp(2.5rem, 5vw, 3.75rem)" }
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"units": [ "px", "rem", "em", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "30", "name": "Small",   "size": "1rem" },
				{ "slug": "40", "name": "Medium",  "size": "1.5rem" },
				{ "slug": "50", "name": "Large",   "size": "2rem" },
				{ "slug": "60", "name": "X-Large", "size": "3.5rem" },
				{ "slug": "70", "name": "Section",  "size": "clamp(3rem, 6vw, 5.5rem)" }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": true }
			}
		}
	}
}
