# Copy this file to scripts/deploy.env and fill in the real values.
# scripts/deploy.env is gitignored — connection details are never committed.
#
#   cp scripts/deploy.env.example scripts/deploy.env

# SSH target for the Cloudways application (user@host).
# Found in the Cloudways panel under Servers → Master Credentials.
STERLING_SSH_HOST=master_xxxxxxxxxx@0.0.0.0

# Absolute path to the application's web root on that server.
# Cloudways names the application folder after its database, so this is not
# guessable — copy it from Application → Application Settings, or run `pwd`
# inside public_html.
STERLING_APP_PATH=/home/master/applications/xxxxxxxxxx/public_html

# Private key for the above. Optional — omit to use your default SSH agent/key.
STERLING_SSH_KEY=~/.ssh/cloudways_sterling
